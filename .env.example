# ---------------------------------------------------------------
# ReelLab — environment template
# Copy to `.env` at the repo root. NEVER commit the real `.env`.
#
#   cp .env.example .env
#
# The backend, the AI service and docker-compose all read this file.
# ---------------------------------------------------------------

# --- Runtime -----------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Datastore ---------------------------------------------------
# The backend starts even when Mongo is unreachable (degraded mode).
MONGODB_URI=mongodb://localhost:27017/reellab

# --- Service topology --------------------------------------------
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- AI provider -------------------------------------------------
# AI_PROVIDER: anthropic | openai | mock
# Leave AI_API_KEY empty during setup — every AI module falls back to
# clearly-marked mock output when no key is present.
AI_PROVIDER=mock
AI_API_KEY=
MULTIMODAL_MODEL=claude-sonnet-5
REASONING_MODEL=claude-opus-5

# --- AI service (Python) -----------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=info
# Cost guard rails — see docs/architecture.md#cost-aware-architecture
AI_MAX_PERSONAS=25
AI_REQUEST_TIMEOUT_SECONDS=120

# --- Backend uploads ---------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100

# --- Frontend (Vite; must be prefixed with VITE_) ------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_USE_MOCKS=true
