# ---------------------------------------------------------------
# ReelLab — root .gitignore
# ---------------------------------------------------------------

# Environment / secrets
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Build output
dist/
build/
.vite/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Runtime artifacts
uploads/
logs/
*.log
tmp/
.cache/

# Media — never commit real reels
data/sample_reels/*
!data/sample_reels/.gitkeep
!data/sample_reels/README.md
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.m4a

# Coverage
coverage/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
